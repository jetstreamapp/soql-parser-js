{
  // Typechecks the whole tree, including tests and scripts, which tsconfig.json excludes
  // because it only emits declarations for the published `src/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "isolatedDeclarations": false,
    "declarationDir": null,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "cli/**/*.ts"],
  "exclude": ["node_modules", "dist", "docs"]
}
